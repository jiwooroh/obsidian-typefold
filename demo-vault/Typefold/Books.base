filters:
  and:
    - 'file.inFolder("Books")'
    - 'file.basename != file.folder.split("/")[-1]'
views:
  - type: table
    name: Table
    order:
      - file.name
      - status
      - author
      - year
      - rating
      - file.mtime
    sort:
      - property: file.mtime
        direction: DESC
  - type: cards
    name: Cards
    order:
      - file.name
      - author
      - year
      - rating
