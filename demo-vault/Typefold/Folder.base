filters:
  and:
    - file.inFolder(this.file.folder)
    - file.name != this.file.name
    - file.basename != file.folder.split("/")[-1]
views:
  - type: table
    name: Table
    groupBy:
      property: file.folder
      direction: ASC
    order:
      - file.name
      - file.mtime
    sort:
      - property: file.mtime
        direction: DESC
  - type: cards
    name: Cards
    order:
      - file.name
      - file.mtime
